# Local Claude Code artifacts, not part of the project
.claude/
scratch/

# Paznaun App has its own separate repository already
/Paznaun App/

# OS junk
.DS_Store
Thumbs.db

# Python bytecode from tools/
__pycache__/
*.pyc

# The paste-ready browser bundle is generated by tests/run.py on demand.
tests/_bundle.js
tests/__pycache__/

# Kratzverzeichnis dieser Sitzungen (Overpass-Caches, Zwischenstaende, Laufprotokolle).
# Steht hier, weil ein `git add -A` es einmal komplett mitgenommen hat.
.tmpwork/

# Stray OpenTopoData cache when a script is run from the repo root instead of tools/.
elevation_cache.json

# Roh-XML der Outdooractive-Ernte: 1 MB fuer 44 Touren, wovon drei Zahlen je Tour gebraucht werden.
# Die stehen eingekocht in Material/Saalbach/oa_official.json; das Verzeichnis ist nur ein Cache und
# baut sich mit tools/harvest_oa_official.py von selbst wieder auf.
Material/*/oa_official/
